# -------------------------
# Postgres container bootstrap
# -------------------------
# Required: Compose refuses to start while it is empty. This file ships every
# credential empty, so no installation runs on a value anyone can read here.
# Generate one with: openssl rand -hex 32
POSTGRES_USER=ospmae
POSTGRES_PASSWORD=
POSTGRES_DB=ospmae

# -------------------------
# API runtime
# -------------------------
# Follows POSTGRES_* above. A password with characters that are special in a
# URL (such as @ : / ? #) must be percent-encoded here; one made with
# `openssl rand -hex 32` needs no encoding.
OSPMAE_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
OSPMAE_API_HOST=0.0.0.0
OSPMAE_API_PORT=8080


# Session / CSRF
# Secure cookies travel only over HTTPS; turn OSPMAE_COOKIE_SECURE off only
# for a local test over plain HTTP. With Secure cookies and no
# OSPMAE_COOKIE_DOMAIN, the session, CSRF and sign-in cookies are set with
# the __Host- prefix (__Host-ospmae_session, __Host-ospmae_csrf), so a site on
# a sibling subdomain can neither set nor shadow them; give the names here
# without the prefix. The bundled UI reads the CSRF cookie under these names.
OSPMAE_SESSION_COOKIE_NAME=ospmae_session
# Sessions live in Valkey (OSPMAE_REDIS_URL below). A session ends after this
# long unused, and in any case this long after sign-in (30 days; at least
# 300), for every sign-in method.
OSPMAE_SESSION_TTL_SECONDS=43200
OSPMAE_SESSION_MAX_AGE_SECONDS=2592000
OSPMAE_COOKIE_SECURE=true
OSPMAE_COOKIE_SAMESITE=lax
OSPMAE_COOKIE_DOMAIN=
OSPMAE_CSRF_COOKIE_NAME=ospmae_csrf
OSPMAE_CSRF_HEADER_NAME=X-CSRF-Token
OSPMAE_CSRF_COOKIE_SAMESITE=strict

# Sign-in and password-change limits (defence in depth; also enforce at your
# reverse proxy). The per-address allowance applies to browsers not
# recognised for the account; the account throttle schedule is fixed.
OSPMAE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
OSPMAE_LOGIN_RATE_LIMIT_PER_IP=30
OSPMAE_PASSWORD_CHANGE_RATE_LIMIT_PER_ACCOUNT=15

# Trusted proxy networks for forwarded client addresses (comma-separated CIDRs).
# Client addresses used for rate limits and audit records walk X-Forwarded-For
# right-to-left only while every hop is inside these networks; with the setting
# unset, only loopback counts, and internet clients cannot spoof them. Only
# hosts that are append-only forwarding proxies belong here. The trusted
# identity header below has its own list. docker-compose.yml trusts exactly
# the component-ui container and the network gateway (for a TLS proxy on the
# host) when this is left unset; set it only for another topology. The
# gateway is trusted so that a TLS proxy on the host can pass client
# addresses on: that proxy must append to X-Forwarded-For. A client that
# reaches the published port through the gateway with no such proxy in front
# chooses the address its rate limits and audit rows are recorded under, so
# publish the port to the host proxy alone, or list only the component-ui
# address here.
# OSPMAE_SECURITY_TRUSTED_PROXY_CIDRS=172.30.66.10/32,172.30.66.1/32

# The compose network. Change these where the default subnet clashes with
# another network on the host; the addresses above follow them.
# OSPMAE_NETWORK_SUBNET=172.30.66.0/24
# OSPMAE_NETWORK_GATEWAY=172.30.66.1
# OSPMAE_UI_ADDRESS=172.30.66.10

# Budgets for the worker that clones and catalogues repositories.
# OSPMAE_WORKER_MEM_LIMIT=2g
# OSPMAE_WORKER_CPUS=2.0
# OSPMAE_WORKER_CONCURRENCY=2

# Optional trusted upstream identity (Vouch/OIDC proxy)
# Set true ONLY when your network path guarantees the API is reachable through
# the authenticating proxy alone. Only the single configured header below is
# honoured. The supplied nginx clears the client's copies of the names such
# proxies commonly use (REMOTE_USER, Remote-User, X-Remote-User, X-Vouch-User,
# X-Forwarded-User, X-Forwarded-Preferred-Username, X-Forwarded-Email,
# X-Auth-Request-*, X-Authenticated-User, X-Authentik-Username,
# X-Webauth-User) and forwards any other header unchanged: if you set
# OSPMAE_REMOTE_USER_HEADER_NAME to a name outside that list, clear or
# overwrite that name in your proxy configuration too.
OSPMAE_TRUST_REMOTE_USER=false
OSPMAE_REMOTE_USER_HEADER_NAME=REMOTE_USER
# The authenticating proxies whose identity header OSPMAE accepts, as
# comma-separated addresses or CIDRs. Required when OSPMAE_TRUST_REMOTE_USER
# is true: OSPMAE does not start in that mode without it. This list is
# separate from OSPMAE_SECURITY_TRUSTED_PROXY_CIDRS, so a hop trusted to forward client
# addresses (the Compose default includes the network gateway, which every
# process on the Docker host connects through) cannot name the signed-in
# account. Name the proxy's own address, for example 172.30.66.10/32.
OSPMAE_REMOTE_USER_TRUSTED_CIDRS=

# -------------------------
# Authentication and SSO
# -------------------------
# Native (local) auth login form. Set false to force SSO-only deployments.
OSPMAE_LOCAL_AUTH_ENABLED=true

# Local second factor on top of passwords: TOTP authenticator apps,
# security keys/passkeys (WebAuthn) and single-use recovery codes.
# Which local accounts must complete the second factor: optional | admins | all.
OSPMAE_MFA_POLICY=optional
# Characters a new local password needs (NIST SP 800-63B-4): 15 where a
# password can be an account's only factor. A value from 8 to 14 is accepted
# only with OSPMAE_MFA_POLICY=all. New passwords are also refused when they
# are commonly used, a keyboard or counting sequence, or contain the username.
OSPMAE_PASSWORD_MIN_LENGTH=15
# Persistent Fernet key used to encrypt TOTP secrets and private repository
# access tokens at rest, e.g. from `openssl rand -base64 32`. Keep it in your
# secrets manager and protected backups: enrolment and saving repository
# tokens refuse without a valid key, and with a changed key existing
# authenticators cannot verify and repository tokens must be entered again.
OSPMAE_MFA_ENCRYPTION_KEY=

# Optional first administrator, created only while the database holds no
# account at all; remove both values after the first sign-in. The password
# follows the rules above.
OSPMAE_BOOTSTRAP_ADMIN_USERNAME=
OSPMAE_BOOTSTRAP_ADMIN_PASSWORD=

# Public base URL (required): the origin browsers reach OSPMAE at, without a
# path. It is the one origin accepted for sign-in, writes, second-factor
# ceremonies and notification sockets, and the host of links sent by email
# (project releases, questions, shared manifests, SSO email address
# verification). It is never derived from
# request Host headers. OSPMAE does not start without it.
# e.g. https://ospmae.example.com
OSPMAE_PUBLIC_BASE_URL=

# Generic OpenID Connect provider. A provider username or verified email
# address must match exactly one existing, enabled OSPMAE account before a
# session is issued. Disabling a provider ends the sessions it opened.
OSPMAE_OIDC_ENABLED=false
OSPMAE_OIDC_PROVIDER_LABEL=OpenID Connect

# The provider's endpoints, given explicitly (OSPMAE does no discovery).
# For Ory Hydra these are typically /oauth2/auth and /oauth2/token, and a JWKS URL.
OSPMAE_OIDC_AUTHORIZATION_ENDPOINT=
OSPMAE_OIDC_TOKEN_ENDPOINT=
# How OSPMAE presents its client secret to the token endpoint:
# client_secret_basic or client_secret_post.
OSPMAE_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
OSPMAE_OIDC_JWKS_URI=
OSPMAE_OIDC_ISSUER=
OSPMAE_OIDC_USERINFO_ENDPOINT=
OSPMAE_OIDC_CLIENT_ID=
OSPMAE_OIDC_CLIENT_SECRET=
OSPMAE_OIDC_SCOPES=openid email profile
# Register this callback with the provider, e.g.
# https://ospmae.example.com/api/v1/auth/oidc/callback
OSPMAE_OIDC_REDIRECT_URI=
OSPMAE_OIDC_END_SESSION_ENDPOINT=
OSPMAE_OIDC_POST_LOGOUT_REDIRECT_URI=
OSPMAE_OIDC_ID_TOKEN_LEEWAY_SECONDS=30
OSPMAE_OIDC_USERNAME_CLAIMS=preferred_username,email
# ID token signing algorithms accepted, space- or comma-separated. Asymmetric
# algorithms only (RS*, PS*, ES*, EdDSA); a shared-secret one refuses sign-in.
OSPMAE_OIDC_ALLOWED_ALGS=RS256
# Auto-link requires an exact provider-verified email already verified in
# Account > SSO email addresses; verifying one needs SMTP and the public base
# URL. Existing issuer/subject links are kept.
OSPMAE_OIDC_AUTO_LINK_EXISTING=true
# Comma-separated. When set, every sign-in through this provider needs a
# provider-verified email address in one of these domains, including
# identities linked earlier. The Google and GitHub settings work the same way.
OSPMAE_OIDC_ALLOWED_EMAIL_DOMAINS=
# Keep false: provider sign-in only reaches existing accounts.
OSPMAE_OIDC_AUTO_PROVISION=false
# Development only. Keep false in production so provider endpoints must be HTTPS.
OSPMAE_OIDC_ALLOW_INSECURE_HTTP=false

# Google OIDC SSO. The defaults work for Google consumer accounts and any
# Google Workspace domain; leave OSPMAE_GOOGLE_ALLOWED_EMAIL_DOMAINS empty to
# allow all Workspace domains.
OSPMAE_GOOGLE_SSO_ENABLED=false
OSPMAE_GOOGLE_PROVIDER_LABEL=Google
OSPMAE_GOOGLE_CLIENT_ID=
OSPMAE_GOOGLE_CLIENT_SECRET=
OSPMAE_GOOGLE_SCOPES=openid email profile
# Register this callback in Google Cloud, e.g.
# https://ospmae.example.com/api/v1/auth/sso/google/callback
OSPMAE_GOOGLE_REDIRECT_URI=
OSPMAE_GOOGLE_AUTO_LINK_EXISTING=true
OSPMAE_GOOGLE_ALLOWED_EMAIL_DOMAINS=
OSPMAE_GOOGLE_AUTO_PROVISION=false
OSPMAE_GOOGLE_USERNAME_CLAIMS=email
# Optional overrides; normally leave these as defaults.
OSPMAE_GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
OSPMAE_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
OSPMAE_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
OSPMAE_GOOGLE_ISSUER=https://accounts.google.com,accounts.google.com
OSPMAE_GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
OSPMAE_GOOGLE_END_SESSION_ENDPOINT=
OSPMAE_GOOGLE_POST_LOGOUT_REDIRECT_URI=

# GitHub OAuth SSO. Register this callback in your GitHub OAuth app, e.g.
# https://ospmae.example.com/api/v1/auth/sso/github/callback
OSPMAE_GITHUB_SSO_ENABLED=false
OSPMAE_GITHUB_PROVIDER_LABEL=GitHub
OSPMAE_GITHUB_CLIENT_ID=
OSPMAE_GITHUB_CLIENT_SECRET=
OSPMAE_GITHUB_SCOPES=read:user user:email
OSPMAE_GITHUB_REDIRECT_URI=
OSPMAE_GITHUB_AUTO_LINK_EXISTING=true
OSPMAE_GITHUB_ALLOWED_EMAIL_DOMAINS=
OSPMAE_GITHUB_AUTO_PROVISION=false
# Optional overrides; normally leave these as defaults.
OSPMAE_GITHUB_AUTHORIZATION_ENDPOINT=https://github.com/login/oauth/authorize
OSPMAE_GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
OSPMAE_GITHUB_USER_ENDPOINT=https://api.github.com/user
OSPMAE_GITHUB_EMAILS_ENDPOINT=https://api.github.com/user/emails
OSPMAE_GITHUB_ISSUER=https://github.com/login/oauth

# LDAP directory sign-in (alongside optional local accounts and SSO).
# ldap:// uses mandatory StartTLS before any bind; ldaps:// uses TLS immediately.
OSPMAE_LDAP_ENABLED=false
OSPMAE_LDAP_URL=ldaps://ldap.example.org:636
# A read-only search account. Leave BOTH empty only if anonymous searches are allowed.
OSPMAE_LDAP_BIND_DN=
OSPMAE_LDAP_BIND_PASSWORD=
# Full search base DN. An OU DN restricts sign-in to that OU and its descendants.
OSPMAE_LDAP_BASE_DN=ou=People,dc=example,dc=org
OSPMAE_LDAP_USERNAME_ATTRIBUTE=uid
OSPMAE_LDAP_EMAIL_ATTRIBUTE=mail
# Stable, unique directory identity: entryUUID for OpenLDAP; objectGUID for AD.
OSPMAE_LDAP_ID_ATTRIBUTE=entryUUID
OSPMAE_LDAP_USER_FILTER=(objectClass=person)
# Optional group restriction, for directories that record membership on the
# group entry. When set, sign-in also needs a group matching this filter to
# list the user. memberUid is compared with the directory username; any other
# attribute, such as member or uniqueMember, with the user's DN. An empty
# group base uses the base DN.
OSPMAE_LDAP_GROUP_FILTER=
OSPMAE_LDAP_GROUP_BASE_DN=
OSPMAE_LDAP_GROUP_MEMBER_ATTRIBUTE=member
# PEM CA file path inside the API container; empty uses the system CA store.
OSPMAE_LDAP_CA_CERT_PATH=
OSPMAE_LDAP_TIMEOUT_SECONDS=5
# Creates ordinary OSPMAE accounts after a successful directory bind; never
# links by email or name.
OSPMAE_LDAP_AUTO_PROVISION=true

# -------------------------
# SMTP (security notices, SSO email verification and project notices)
# -------------------------
OSPMAE_SMTP_HOST=
OSPMAE_SMTP_PORT=587
OSPMAE_SMTP_USERNAME=
OSPMAE_SMTP_PASSWORD=
OSPMAE_SMTP_USE_TLS=true
OSPMAE_SMTP_USE_SSL=false
OSPMAE_SMTP_TIMEOUT_SECONDS=20
OSPMAE_SMTP_FROM_EMAIL=
OSPMAE_SMTP_FROM_NAME=OSPMAE

# -------------------------
# Valkey/Redis: sessions, sign-in throttles, rate limits, notification
# delivery between API processes, and the Celery broker
# -------------------------
# Required: Compose refuses to start while it is empty.
# Generate one with: openssl rand -hex 32
REDIS_PASSWORD=

# In docker-compose these point at the bundled Redis container.
OSPMAE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
OSPMAE_CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
OSPMAE_CELERY_TIMEZONE=UTC

# How long a worker task may run, in seconds. At a minute before the limit
# the task is told to stop (a scan records that as its error); at the limit
# its process is replaced. Scans (clone, syft, grype, lockfiles) and release
# feed tasks have their own, longer limits.
OSPMAE_TASK_TIME_LIMIT_SECONDS=900
OSPMAE_SCAN_TASK_TIME_LIMIT_SECONDS=1800
OSPMAE_FEED_TASK_TIME_LIMIT_SECONDS=1800

# Days the request audit trail keeps its records. The worker deletes older
# records on its sweep; 0 keeps them indefinitely.
OSPMAE_AUDIT_LOG_RETENTION_DAYS=90

# Release feed polling (RSS/Atom) - creates draft versions when new releases appear.
OSPMAE_RELEASE_FEED_POLL_ENABLED=true
OSPMAE_RELEASE_FEED_POLL_MINUTES=15

# -------------------------
# Installation feature switches (modularise the deployment)
# -------------------------
# Administrators switch these areas on and off on the Administration page
# (Features tab). These settings are the deployment's ceiling: false turns an
# area off entirely whatever the page says (its API routes answer 404, its
# background tasks become no-ops and the UI hides its pages), and the page
# cannot turn it back on. Authentication, projects and the vulnerability
# dashboard always stay on.
OSPMAE_FEATURE_FRAMEWORKS=true
OSPMAE_FEATURE_MANIFESTS=true
OSPMAE_FEATURE_QUESTIONS=true
OSPMAE_FEATURE_DEPENDENCY_SCANS=true
OSPMAE_FEATURE_COMPARISONS=true
OSPMAE_FEATURE_RELEASE_FEED=true

# -------------------------
# Dependency discovery
# -------------------------
OSPMAE_DEPENDENCY_DISCOVERY_ENABLED=true
OSPMAE_DEPENDENCY_DISCOVERY_AUTO_ENQUEUE=true

# Optional hostname allowlist (comma-separated). Empty = allow all.
OSPMAE_DEPENDENCY_DISCOVERY_ALLOWED_HOSTS=github.com,gitlab.com,codeberg.org

# Safety limits
OSPMAE_DEPENDENCY_DISCOVERY_MAX_FILE_BYTES=5000000
OSPMAE_DEPENDENCY_DISCOVERY_MAX_FILES=2500
OSPMAE_DEPENDENCY_DISCOVERY_CLONE_TIMEOUT_SECONDS=180

# Optional Syft dependency cataloging. This is the Anchore package inventory/SBOM
# step; keep enabled if you want scanner-like dependency discovery rather than
# relying only on OSPMAE's built-in lockfile parsers.
OSPMAE_SYFT_ENABLED=true
OSPMAE_SYFT_CMD=syft
OSPMAE_SYFT_TIMEOUT_SECONDS=300

# Optional Grype vulnerability scanning. Dependency discovery still runs when
# this is false, but vulnerability counts/lists are only refreshed when enabled.
OSPMAE_GRYPE_ENABLED=false
OSPMAE_GRYPE_CMD=grype
OSPMAE_GRYPE_TIMEOUT_SECONDS=300

# Optional app label shown in the UI
OSPMAE_APP_TITLE=UWRA Project Catalog
