# -------------------------
# Postgres container bootstrap
# -------------------------
# IMPORTANT: Change these defaults to strong, unique values before deployment.
# Generate passwords with: openssl rand -base64 32
POSTGRES_USER=ospmae
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD>
POSTGRES_DB=ospmae

# -------------------------
# API runtime
# -------------------------
# Keep this aligned with POSTGRES_* above
OSPMAE_DATABASE_URL=postgresql+psycopg://ospmae:<PASSWORD>@postgres:5432/ospmae
OSPMAE_API_HOST=0.0.0.0
OSPMAE_API_PORT=8080


# Session / CSRF
OSPMAE_SESSION_COOKIE_NAME=ospmae_session
OSPMAE_SESSION_TTL_SECONDS=43200
# IMPORTANT: Set to true in production when using HTTPS (recommended)
OSPMAE_COOKIE_SECURE=true
OSPMAE_COOKIE_SAMESITE=lax
OSPMAE_COOKIE_DOMAIN=
OSPMAE_CSRF_COOKIE_NAME=ospmae_csrf
OSPMAE_CSRF_HEADER_NAME=X-CSRF-Token
OSPMAE_CSRF_COOKIE_SAMESITE=strict

# Trusted proxy networks for forwarded client addresses (comma-separated CIDRs).
# Client addresses used for rate limits and audit records walk X-Forwarded-For
# right-to-left only while every hop is inside these networks; with the setting
# unset, only loopback counts, and internet clients cannot spoof them. Only
# networks whose hosts are append-only forwarded-by trusted proxies belong
# here. The compose default covers the compose network's private range.
OSPMAE_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Post-login redirect allowlist (comma-separated hostnames)
# Same-origin relative paths are always allowed.
# Leave empty to disallow all cross-origin redirects via ?next=.
OSPMAE_LOGIN_REDIRECT_ALLOWED_HOSTS=

# Optional trusted upstream identity (Vouch/OIDC proxy)
# Set true ONLY when your network path guarantees the API is reachable through
# the authenticating proxy alone. Only the single configured header below is
# honoured; the supplied nginx clears every other identity header.
OSPMAE_TRUST_REMOTE_USER=false
OSPMAE_REMOTE_USER_HEADER_NAME=REMOTE_USER

# Optional: auto-create local users when a trusted remote user is first seen.
# This is convenient for SSO-first deployments.
OSPMAE_REMOTE_USER_AUTO_PROVISION=false
OSPMAE_REMOTE_USER_AUTO_PROVISION_ROLE=pending

# -------------------------
# Authentication and SSO
# -------------------------
# Native (local) auth login form. Set false to force SSO-only deployments.
OSPMAE_LOCAL_AUTH_ENABLED=true

# Local second factor on top of passwords: TOTP authenticator apps,
# security keys/passkeys (WebAuthn) and single-use recovery codes.
# Which local accounts must complete the second factor: optional | admins | all.
OSPMAE_MFA_POLICY=optional
# Persistent Fernet key used to encrypt TOTP secrets at rest, e.g. from
# `openssl rand -base64 32`. Keep it in your secrets manager and protected
# backups: enrolment refuses without a valid key, and with a changed key
# existing authenticators cannot verify.
OSPMAE_MFA_ENCRYPTION_KEY=

# Public base URL for links sent by email (password reset, SSO approval,
# email verification). NEVER derived from request Host headers: links sent by
# email stay off for the installation until this is set explicitly.
# e.g. https://ospmae.example.com
OSPMAE_PUBLIC_BASE_URL=

# Optional: notify this administrator address when SSO auto-provisions a user
# for review. May be a single email or a comma-separated list. Requires SMTP.
OSPMAE_ADMIN_NOTIFICATION_EMAIL=

# Generic OpenID Connect provider.
OSPMAE_OIDC_SSO_ENABLED=false
OSPMAE_OIDC_PROVIDER_LABEL=OpenID Connect

# Explicit OIDC endpoints (recommended; avoids discovery).
# For Ory Hydra these are typically /oauth2/auth and /oauth2/token, and a JWKS URL.
OSPMAE_OIDC_AUTHORIZATION_ENDPOINT=
OSPMAE_OIDC_TOKEN_ENDPOINT=
OSPMAE_OIDC_JWKS_URI=
OSPMAE_OIDC_ISSUER=
OSPMAE_OIDC_DISCOVERY_URL=
OSPMAE_OIDC_CLIENT_ID=
OSPMAE_OIDC_CLIENT_SECRET=
OSPMAE_OIDC_SCOPES=openid email profile
# Register this callback with the provider, e.g.
# https://ospmae.example.com/v1/auth/oidc/callback
OSPMAE_OIDC_REDIRECT_URI=
OSPMAE_OIDC_END_SESSION_ENDPOINT=
OSPMAE_OIDC_POST_LOGOUT_REDIRECT_URI=
OSPMAE_OIDC_ID_TOKEN_LEEWAY_SECONDS=30
OSPMAE_OIDC_AUTO_PROVISION=false
OSPMAE_OIDC_AUTO_PROVISION_ROLE=pending
OSPMAE_OIDC_AUTO_LINK_EXISTING=true
OSPMAE_OIDC_ALLOWED_EMAIL_DOMAINS=
OSPMAE_OIDC_USERNAME_CLAIMS=preferred_username,email

# Google OIDC SSO. The defaults work for Google consumer accounts and any
# Google Workspace domain; leave OSPMAE_GOOGLE_ALLOWED_EMAIL_DOMAINS empty to
# allow all Workspace domains.
OSPMAE_GOOGLE_SSO_ENABLED=false
OSPMAE_GOOGLE_PROVIDER_LABEL=Google
OSPMAE_GOOGLE_CLIENT_ID=
OSPMAE_GOOGLE_CLIENT_SECRET=
OSPMAE_GOOGLE_SCOPES=openid email profile
# Register this callback in Google Cloud, e.g.
# https://ospmae.example.com/v1/auth/sso/google/callback
OSPMAE_GOOGLE_REDIRECT_URI=
OSPMAE_GOOGLE_AUTO_PROVISION=false
OSPMAE_GOOGLE_AUTO_PROVISION_ROLE=pending
OSPMAE_GOOGLE_AUTO_LINK_EXISTING=true
OSPMAE_GOOGLE_ALLOWED_EMAIL_DOMAINS=
# Optional overrides; normally leave these as defaults.
OSPMAE_GOOGLE_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
OSPMAE_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
OSPMAE_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
OSPMAE_GOOGLE_ISSUER=https://accounts.google.com,accounts.google.com
OSPMAE_GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
OSPMAE_GOOGLE_USERNAME_CLAIMS=email
OSPMAE_GOOGLE_END_SESSION_ENDPOINT=
OSPMAE_GOOGLE_POST_LOGOUT_REDIRECT_URI=

# GitHub OAuth SSO. Register this callback in your GitHub OAuth app, e.g.
# https://ospmae.example.com/v1/auth/sso/github/callback
OSPMAE_GITHUB_SSO_ENABLED=false
OSPMAE_GITHUB_PROVIDER_LABEL=GitHub
OSPMAE_GITHUB_CLIENT_ID=
OSPMAE_GITHUB_CLIENT_SECRET=
OSPMAE_GITHUB_SCOPES=read:user user:email
OSPMAE_GITHUB_REDIRECT_URI=
OSPMAE_GITHUB_AUTO_PROVISION=false
OSPMAE_GITHUB_AUTO_PROVISION_ROLE=pending
OSPMAE_GITHUB_AUTO_LINK_EXISTING=true
OSPMAE_GITHUB_ALLOWED_EMAIL_DOMAINS=
# Optional overrides; normally leave these as defaults.
OSPMAE_GITHUB_AUTHORIZATION_ENDPOINT=https://github.com/login/oauth/authorize
OSPMAE_GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
OSPMAE_GITHUB_USER_ENDPOINT=https://api.github.com/user
OSPMAE_GITHUB_EMAILS_ENDPOINT=https://api.github.com/user/emails
OSPMAE_GITHUB_ISSUER=https://github.com/login/oauth

# If you want the app to derive redirect URIs from X-Forwarded-* headers,
# enable this ONLY when behind a trusted proxy/ingress.
OSPMAE_TRUST_PROXY_HEADERS=false

# -------------------------
# SMTP (password reset emails and admin notifications)
# -------------------------
OSPMAE_SMTP_HOST=
OSPMAE_SMTP_PORT=587
OSPMAE_SMTP_USERNAME=
OSPMAE_SMTP_PASSWORD=
OSPMAE_SMTP_USE_TLS=true
OSPMAE_SMTP_USE_SSL=false
OSPMAE_SMTP_TIMEOUT_SECONDS=20
OSPMAE_SMTP_FROM_EMAIL=
OSPMAE_SMTP_FROM_NAME=OSPMAE

# Password reset token validity
OSPMAE_PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# -------------------------
# Celery/Redis
# -------------------------
# IMPORTANT: Change this default before deployment
REDIS_PASSWORD=<GENERATE_STRONG_PASSWORD>

# In docker-compose this points at the bundled Redis container.
OSPMAE_CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
OSPMAE_CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis:6379/1
OSPMAE_CELERY_TIMEZONE=UTC

# Release feed polling (RSS/Atom) - creates draft versions when new releases appear.
OSPMAE_RELEASE_FEED_POLL_ENABLED=true
OSPMAE_RELEASE_FEED_POLL_MINUTES=15

# -------------------------
# Installation feature switches (modularise the deployment)
# -------------------------
# Each switch turns an optional product area off entirely: its API routes
# answer 404, its background tasks become no-ops and the UI hides its pages.
# Authentication, projects and the vulnerability dashboard always stay on.
OSPMAE_FEATURE_FRAMEWORKS=true
OSPMAE_FEATURE_MANIFESTS=true
OSPMAE_FEATURE_QUESTIONS=true
OSPMAE_FEATURE_DEPENDENCY_SCANS=true
OSPMAE_FEATURE_COMPARISONS=true
OSPMAE_FEATURE_RELEASE_FEED=true

# -------------------------
# Dependency discovery
# -------------------------
OSPMAE_DEPENDENCY_DISCOVERY_ENABLED=true
OSPMAE_DEPENDENCY_DISCOVERY_AUTO_ENQUEUE=true

# Optional hostname allowlist (comma-separated). Empty = allow all.
OSPMAE_DEPENDENCY_DISCOVERY_ALLOWED_HOSTS=github.com,gitlab.com,codeberg.org

# Safety limits
OSPMAE_DEPENDENCY_DISCOVERY_MAX_FILE_BYTES=5000000
OSPMAE_DEPENDENCY_DISCOVERY_MAX_FILES=2500
OSPMAE_DEPENDENCY_DISCOVERY_CLONE_TIMEOUT_SECONDS=180

# Optional Syft dependency cataloging. This is the Anchore package inventory/SBOM
# step; keep enabled if you want scanner-like dependency discovery rather than
# relying only on OSPMAE's built-in lockfile parsers.
OSPMAE_SYFT_ENABLED=true
OSPMAE_SYFT_CMD=syft
OSPMAE_SYFT_TIMEOUT_SECONDS=300

# Optional Grype vulnerability scanning. Dependency discovery still runs when
# this is false, but vulnerability counts/lists are only refreshed when enabled.
OSPMAE_GRYPE_ENABLED=false
OSPMAE_GRYPE_CMD=grype
OSPMAE_GRYPE_TIMEOUT_SECONDS=300

# Optional app label shown in UI
OSPMAE_APP_TITLE=Component Catalog
